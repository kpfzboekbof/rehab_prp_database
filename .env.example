# SQLite database file location.
# NOTE: Prisma resolves relative file: paths *relative to schema.prisma*,
# so `file:../data/prp.db` puts the DB at <repo>/data/prp.db (which matches
# the `/data` rule in .gitignore).
# In Docker compose we override this to an absolute `file:/app/data/prp.db`.
DATABASE_URL="file:../data/prp.db"

# Auth.js v5 requires a secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-openssl-rand-base64-32"

# Needed when running behind a reverse proxy or inside Docker without a public URL.
AUTH_TRUST_HOST="true"

# Seed script picks these up when running `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@clinic.local"
SEED_ADMIN_PASSWORD="changeme"
SEED_ADMIN_NAME="管理員"
