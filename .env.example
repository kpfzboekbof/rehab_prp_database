# ---------------------------------------------------------------------------
# PostgreSQL (Neon / Vercel Postgres / self-hosted)
# ---------------------------------------------------------------------------
#
# DATABASE_URL: pooled connection string used by the app at runtime.
#   - Neon: use the "Pooled connection" string (host ends with `-pooler`)
#   - Must include `?sslmode=require` for Neon
#   - Example: postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/prp?sslmode=require
#
# DIRECT_URL: direct (non-pooled) connection used ONLY by Prisma Migrate.
#   - Neon: use the "Direct connection" string (host does NOT end with `-pooler`)
#   - Same credentials, same database, different host
#   - Required because pgBouncer-pooled connections do not support all the
#     session-level features that `prisma migrate` needs.
#
DATABASE_URL="postgres://user:password@host-pooler.region.aws.neon.tech/prp?sslmode=require"
DIRECT_URL="postgres://user:password@host.region.aws.neon.tech/prp?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-openssl-rand-base64-32"

# Tell Auth.js to trust the Host header when running behind a proxy (Vercel).
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# Read by `npm run db:seed` to create the initial admin user.
SEED_ADMIN_EMAIL="admin@clinic.local"
SEED_ADMIN_PASSWORD="changeme"
SEED_ADMIN_NAME="管理員"
