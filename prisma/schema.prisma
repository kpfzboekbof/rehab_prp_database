// PRP 病人管理系統 — Prisma schema
//
// Design notes:
// - SQLite for zero-ops single-clinic deployment.
// - Snapshot fields on TreatmentRecord (unitPriceSnapshot, totalAmount,
//   commissionRateSnapshot, commissionAmount) freeze history so that
//   changing product prices or doctor commission rates never corrupts
//   past revenue reports.
// - Soft-delete on Patient only (`deletedAt`) to satisfy Taiwan's 7-year
//   medical record retention (醫療法).
// - FollowUpCall has `externalMessageId` + `channel` as forward-compat
//   hooks for a future LINE bot integration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL is used by Prisma Migrate / Introspect. With Neon's pgBouncer
  // pooler in DATABASE_URL, migrations must go through a direct (non-pooled)
  // connection — set DIRECT_URL to Neon's "Direct connection" string.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------

enum Role {
  DOCTOR
  STAFF
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Clinical relations
  createdPatients Patient[]              @relation("PatientCreatedBy")
  treatments      TreatmentRecord[]      @relation("TreatmentDoctor")
  authoredCalls   FollowUpCall[]         @relation("CallAuthor")
  commissionRates   DoctorCommissionRate[]
  outreachContacts  OutreachContact[]      @relation("OutreachContactedBy")

  // Auth.js adapter tables (kept for future OAuth; credentials provider uses JWT sessions)
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain enums ----------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BodyPart {
  KNEE
  SHOULDER
  ELBOW
  WRIST
  HAND
  HIP
  ANKLE
  FOOT
  CERVICAL_SPINE
  THORACIC_SPINE
  LUMBAR_SPINE
  SACROILIAC
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

/// 診次：早診 / 午診 / 晚診。跟 scheduledAt 搭配使用 —
/// 新建的回診紀錄 scheduledAt 固定為 Taipei 午夜（代表當日），
/// 具體時段用這個 enum 表達。enum 的宣告順序就是排序順序。
enum AppointmentSession {
  MORNING
  AFTERNOON
  EVENING
}

/// Reason tag for an outreach / marketing contact event. Each list on
/// the /outreach page corresponds to one of these reasons, and a
/// contact record is tagged with the reason so the same patient can
/// be logged once per campaign without the records colliding.
enum OutreachReason {
  DORMANT            // 沉睡病人：很久沒治療
  PACKAGE_FINISHED   // 套組用完未續購
  NO_SHOW            // 爽約未補約
  INCOMPLETE_PACKAGE // 套組還沒用完但停擺（預留給未來）
  OTHER              // 其他
}

// ---------- Domain tables ----------

model Patient {
  id          String  @id @default(cuid())
  chartNumber String  @unique
  name        String
  gender      Gender
  birthDate   DateTime
  phone       String?
  address     String?
  notes       String?

  deletedAt DateTime? // soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdById String
  createdBy   User   @relation("PatientCreatedBy", fields: [createdById], references: [id])

  treatments       TreatmentRecord[]
  appointments     FollowUpAppointment[]
  outreachContacts OutreachContact[]

  @@index([name])
  @@index([deletedAt])
}

model PRPProduct {
  id   String  @id @default(cuid())
  name String  @unique
  // Integer NTD. Meaning depends on packageSize:
  //   - Regular product (packageSize = null): per-vial price.
  //   - Package product (packageSize != null): TOTAL package price (the
  //     whole set is paid once upfront). Average per-vial is computed
  //     for display only as `unitPrice / packageSize` and is not stored
  //     separately because some package totals don't divide evenly.
  unitPrice Int
  active    Boolean @default(true)
  notes     String?

  // Null for a regular single-use product (quantity = vialsUsed).
  // Non-null marks this as a prepaid package — the number is the total
  // vials included, and the patient pays once at purchase time but
  // consumes them across multiple visits. See TreatmentRecord.vialsUsed.
  packageSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatments TreatmentRecord[]
}

model TreatmentRecord {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         User     @relation("TreatmentDoctor", fields: [doctorId], references: [id])

  treatmentDate      DateTime
  bodyPart           BodyPart
  bodyPartDetail     String? // free-text escape hatch, e.g. "left medial meniscus"
  symptoms           String
  painBefore         Int // 0-10
  painImmediateAfter Int? // measured same visit; may be null if not recorded
  ultrasoundNote     String? // v1 is text-only, no file upload
  physicianNote      String?

  productId         String
  product           PRPProduct @relation(fields: [productId], references: [id])
  quantity          Int // Billed vials. For regular products: == vialsUsed. For prepaid packages: packageSize on purchase visit, 0 on subsequent use visits.
  vialsUsed         Int        @default(0) // Vials actually injected this visit. For regular products == quantity.
  unitPriceSnapshot Int // frozen on create
  totalAmount       Int // quantity * unitPriceSnapshot, frozen on create

  // Commission frozen on create so the monthly report is a pure aggregation.
  commissionRateSnapshot Float
  commissionAmount       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments FollowUpAppointment[]

  @@index([patientId])
  @@index([doctorId])
  @@index([treatmentDate])
  @@index([bodyPart])
}

model FollowUpAppointment {
  id                String           @id @default(cuid())
  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceTreatmentId String?
  sourceTreatment   TreatmentRecord? @relation(fields: [sourceTreatmentId], references: [id], onDelete: SetNull)

  scheduledAt DateTime // Taipei-midnight of the appointment day for new records (the time component is meaningless; use `session` for time-of-day).
  session     AppointmentSession @default(MORNING)
  status      AppointmentStatus  @default(SCHEDULED)
  reason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUpCall FollowUpCall?

  @@index([scheduledAt])
  @@index([patientId])
  @@index([status])
}

model FollowUpCall {
  id            String              @id @default(cuid())
  appointmentId String              @unique
  appointment   FollowUpAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  calledAt   DateTime @default(now())
  calledById String
  calledBy   User     @relation("CallAuthor", fields: [calledById], references: [id])

  // Fields from the user story
  symptomImprovement      String? // qualitative note
  longTermPainImprovement Int? // optional 0-10 scale captured at follow-up
  educationDone           Boolean @default(false)
  appointmentConfirmed    Boolean @default(false)
  patientFeedback         String?
  notes                   String?

  // Forward-compat for future LINE bot automation
  externalMessageId String?
  channel           String  @default("PHONE") // PHONE | LINE | ...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DoctorCommissionRate {
  id            String    @id @default(cuid())
  doctorId      String
  doctor        User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rate          Float // 0.0 - 1.0
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, effectiveFrom])
}

/// Record of an outreach / marketing contact event. One row per
/// (patient, reason, contact attempt). Used by the /outreach lists to
/// mark patients as "already called for this campaign" so they don't
/// keep showing up on top. Distinct from `FollowUpCall`, which is a
/// clinical reminder call tied to a specific appointment.
model OutreachContact {
  id            String         @id @default(cuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reason        OutreachReason
  contactedAt   DateTime       @default(now())
  contactedById String
  contactedBy   User           @relation("OutreachContactedBy", fields: [contactedById], references: [id])
  outcome       String? // short free-text: 已預約 / 考慮中 / 拒絕 / 電話不通 …
  notes         String?

  createdAt DateTime @default(now())

  @@index([patientId, reason, contactedAt])
  @@index([reason, contactedAt])
}
